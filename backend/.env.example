# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas M0 Free Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/flexio_leaderboard?retryWrites=true&w=majority
MONGODB_URI=

# Security & Authentication
JWT_SECRET=replace-with-a-very-long-random-secret-key-32-chars-min
JWT_EXPIRES_IN=8h

# Cloudinary Image Storage Configuration (Free Tier)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Company Defaults
COMPANY_NAME=Flexio Global Technologies
COMPANY_LOGO_URL=

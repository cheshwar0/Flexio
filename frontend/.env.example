# ==============================================================================
# FLEXIO FRONTEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

# Backend API Base URL
# - Local Development: http://localhost:5000/api (or /api if using Vite proxy)
# - Production Deployment (e.g. Render, Railway, AWS, Vercel):
#   Set to your live backend domain, e.g.:
#   VITE_API_URL=https://your-backend-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api
